{
  "name": "malipedefe",
  "productName": "MaliPDF",
  "version": "1.0.0",
  "description": "Professional PDF Annotation & Document Workspace",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/writeBuildInfo.mjs && node scripts/buildVisionHelper.mjs",
    "build:ocr": "node scripts/buildVisionHelper.mjs --force",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:coordinate": "vitest run src/pdf/__tests__"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.441.0",
    "mathlive": "^0.110.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.4",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "author": {
    "name": "Mehmet Ali Yıldırım",
    "email": "maliyildirim061@gmail.com"
  },
  "homepage": "https://github.com/maliyildirimtr/malipdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/maliyildirimtr/malipdf.git"
  },
  "build": {
    "appId": "com.maliyildirimtr.malipdf",
    "productName": "MaliPDF",
    "copyright": "© Mehmet Ali Yıldırım",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extraResources": [
        {
          "from": "build/native",
          "to": "native",
          "filter": [
            "malipdf-vision"
          ]
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "MaliPDF uses screen capture to insert screenshots into your PDF."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaliPDF",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "appx": {
      "identityName": "MehmetAliYldrm.MaliPDF",
      "publisher": "CN=91E39BFD-90E8-4CA1-B4FE-3DAAC4FC4492",
      "publisherDisplayName": "Mehmet Ali YILDIRIM",
      "displayName": "MaliPDF",
      "applicationId": "MaliPDF",
      "backgroundColor": "transparent",
      "languages": [
        "tr-TR",
        "en-US"
      ],
      "showNameOnTiles": false,
      "artifactName": "MaliPDF-${version}-Store-${arch}.${ext}"
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "provisioningProfile": "build/embedded.provisionprofile",
      "artifactName": "MaliPDF-${version}-MacAppStore.${ext}",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSScreenCaptureUsageDescription": "MaliPDF uses screen capture to insert screenshots into your PDF."
      }
    }
  }
}
